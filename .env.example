# Скопируй в .env:  cp .env.example .env
# .env в git НЕ коммитим (см. .gitignore). Здесь — только dev-значения.
# Добавил новую переменную в код/compose → сразу допиши её сюда.

# ─── Postgres (docker compose) ────────────────────────────────────────────────
POSTGRES_DB=hackalem
POSTGRES_USER=hackalem
POSTGRES_PASSWORD=hackalem
# Порт на ХОСТЕ. Занят локальным Postgres ("port is already allocated")?
# Поставь 5433 и синхронно поправь порт в SPRING_DATASOURCE_URL ниже.
POSTGRES_PORT=5432

# ─── Backend ──────────────────────────────────────────────────────────────────
# Этот URL — для запуска с ХОСТА (./gradlew bootRun).
# Внутри compose backend получает jdbc:postgresql://db:5432/... — это задано
# в docker-compose.yml и переопределяет значение отсюда. Так и задумано.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hackalem
SPRING_DATASOURCE_USERNAME=hackalem
SPRING_DATASOURCE_PASSWORD=hackalem

# Минимум 32 символа для HS256. На проде — другое значение, не из репозитория.
JWT_SECRET=dev-only-secret-change-me-min-32-chars-long
# Время жизни токена в минутах (1440 = сутки)
JWT_TTL_MINUTES=1440

# Origin фронта для CORS (несколько — через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── OpenAI (обязательно) ─────────────────────────────────────────────────────
# Без ключа backend упадёт на старте. Ключ НИКОГДА не коммитим.
OPENAI_API_KEY=sk-replace-me
# Модель по умолчанию для Spring AI
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Пул PostgreSQL для API поиска. Настраивается по результатам load-теста.
DB_POOL_MAX_SIZE=30
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT_MS=2000

# ─── Каталог (CAT-01) ─────────────────────────────────────────────────────────
# Администраторы каталога используют JWT и ADMIN_PRINCIPAL_IDS (AUTH-01).

# Векторы каталога: live (реальная модель, нужен OPENAI_API_KEY) или fake
# (детерминированная заглушка для offline/тестов). Смешивать нельзя: индекс
# помечен пространством векторов, и поиск отказывается работать по чужому.
CATALOG_EMBEDDING_MODE=live
CATALOG_EMBEDDING_BATCH_SIZE=64

# Идемпотентная загрузка синтетического каталога при старте.
# Путь ниже — для ./gradlew bootRun с хоста (рабочая директория backend/).
# В контейнере data/ монтируется как /app/data (см. docker-compose.yml).
CATALOG_SEED_ENABLED=true
CATALOG_SEED_LOCATION=file:../data/sample_catalog/products.json

# Сколько вытесненных версий каталога хранить и какой длины очередь импорта.
CATALOG_RETAINED_VERSIONS=3
CATALOG_IMPORT_QUEUE_CAPACITY=8

# ─── Frontend (build-time!) ───────────────────────────────────────────────────
# Адрес backend ИЗ БРАУЗЕРА пользователя. Браузер не резолвит compose-имена,
# поэтому здесь localhost, а не backend:8080 — даже когда фронт в контейнере.
# Поменял → docker compose up -d --build frontend (значение запекается в бандл).
VITE_API_URL=http://localhost:8080

# D1: contract = offline provider/data fixtures; live requires verified D2 adapters.
SPRING_PROFILES_ACTIVE=live
REDIS_HOST=localhost
REDIS_PORT=6379
VISITOR_SESSION_ENABLED=false
CART_PAGE_URL=/cart
LLM_GLOBAL_RPM=60
LLM_PRINCIPAL_RPM=10
LLM_GLOBAL_TPM=200000
LLM_CONCURRENCY=4
CHAT_QUEUE_SIZE=100
CHAT_WORKER_ENABLED=true
CHAT_WORKER_THREADS=4
CHAT_DEADLINE_SECONDS=60
CHAT_MAX_ROUNDS=4
CHAT_MAX_TOKENS=16000
EVENT_TTL_SECONDS=900
EVENT_MAX_LENGTH=1000
SSE_MAX_SUBSCRIBERS=100
# Optional server-provisioned visitor principal UUIDs allowed to administer imports/metrics.
ADMIN_PRINCIPAL_IDS=

# Partner cart is disabled until the real integration contract has been verified.
# See docs/api/partner-cart.md; origins are comma-separated exact HTTPS origins.
CART_MODE=sample
PARTNER_CART_VERIFIED=false
PARTNER_CART_BASE_URL=
PARTNER_CART_ALLOWED_ORIGINS=
PARTNER_CART_TOKEN=
PARTNER_CART_CONNECT_TIMEOUT_MS=2000
PARTNER_CART_REQUEST_TIMEOUT_MS=5000

# Attachment parsers/OCR. Runtime Docker image includes Tesseract eng+rus.
ATTACHMENT_WORKER_ENABLED=true
ATTACHMENT_OCR_ENABLED=false
ATTACHMENT_OCR_EXECUTABLE=tesseract
ATTACHMENT_OCR_LANGUAGES=eng+rus
# Optional paid vision calls using OPENAI_API_KEY and OPENAI_MODEL.
ATTACHMENT_VISION_ENABLED=false
KNOWLEDGE_SEED_ENABLED=true
KNOWLEDGE_SEED_LOCATION=file:../data/purchase_terms/terms.json
KNOWLEDGE_WORKER_ENABLED=true
