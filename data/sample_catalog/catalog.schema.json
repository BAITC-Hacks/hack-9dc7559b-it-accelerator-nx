{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/synthetic-catalog-v1",
  "title": "DATA-01 synthetic catalog import draft",
  "type": "object",
  "required": ["schemaVersion", "synthetic", "version", "products"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "synthetic": {"const": true},
    "version": {"const": "synthetic-v1"},
    "products": {"type": "array", "minItems": 30, "items": {"$ref": "#/$defs/product"}}
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "product": {
      "type": "object",
      "required": ["id", "article", "name", "brand", "category", "unit", "minimum", "step", "price", "currency", "specs", "certificates", "sourceUrl", "sourceVersion", "synthetic", "warehouses"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "article": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "brand": {"type": "string", "minLength": 1},
        "category": {"enum": ["breakers", "cables", "lamps"]},
        "unit": {"enum": ["pcs", "m"]},
        "minimum": {"$ref": "#/$defs/decimal"},
        "step": {"$ref": "#/$defs/decimal"},
        "price": {"$ref": "#/$defs/decimal"},
        "currency": {"const": "KZT"},
        "specs": {"type": "object", "additionalProperties": {"type": "string"}},
        "certificates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/certificate"}},
        "sourceUrl": {"type": "string", "pattern": "^https://example\\.invalid/"},
        "sourceVersion": {"const": "synthetic-v1"},
        "synthetic": {"const": true},
        "warehouses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/warehouse"}}
      }
    },
    "warehouse": {
      "type": "object",
      "required": ["warehouseId", "availableQuantity", "status", "eligible"],
      "additionalProperties": false,
      "properties": {
        "warehouseId": {"type": "string", "minLength": 1},
        "availableQuantity": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "status": {"enum": ["IN_STOCK", "OUT_OF_STOCK", "ON_ORDER", "UNKNOWN"]},
        "eligible": {"type": "boolean"}
      }
    },
    "certificate": {
      "type": "object",
      "required": ["id", "url", "file", "version", "synthetic"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://example\\.invalid/"},
        "file": {"const": "data/sample_catalog/certificates/synthetic-certificate.pdf"},
        "version": {"const": "1"},
        "synthetic": {"const": true}
      }
    }
  }
}
